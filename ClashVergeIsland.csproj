<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>ClashVergeIsland</RootNamespace>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>

    <!-- 宿主的 plugins 目录：这台机器上 WinIsland 装在 D:\WinIsland -->
    <WinIslandPluginsDir Condition="'$(WinIslandPluginsDir)' == ''">D:\WinIsland\plugins</WinIslandPluginsDir>

    <!-- 插件安装目录名 = 插件 id -->
    <PluginTargetDir>$(WinIslandPluginsDir)\clash-verge-island</PluginTargetDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- 别把本机绝对路径写进 dll。
         默认编译会在 PE 的调试目录里记录 PDB 的**绝对路径**（实测 dll 里能看到 D:\ds\...），
         这个 dll 要公开发到插件市场，等于把自己的目录结构一起发出去。
         关掉调试目录 + 把源码路径映射成中性前缀，两处都堵上。 -->
    <DebugType>none</DebugType>
    <PathMap>$(MSBuildProjectDirectory)=/src</PathMap>
  </PropertyGroup>

  <ItemGroup>
    <!-- 插件 SDK 从 NuGet 装（主次版本 = 宿主 API 版本）。
         ExcludeAssets="runtime"：WinIsland.Core.dll 由宿主提供，不能进插件包 -->
    <PackageReference Include="luolan.winland.Core" Version="2.3.0" PrivateAssets="all" ExcludeAssets="runtime" />

    <!-- Windows App SDK / WinUI 运行时同样由宿主提供，排除出运行时 -->
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <None Update="plugin.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="README.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- 国旗图片：Windows 字体里没有国旗图案，只能自己带。
         必须用 None 而不是 Content：Content 会被 WinUI 的资源管线再拷一份到
         <项目名>\ 目录下，包体积直接翻倍（市场 CI 会挑刺）。
         None + CopyToOutputDirectory 一样能进输出目录，但不会进资源管线。 -->
    <None Include="flags\*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- WinUI 的资源管线会把图片再拷一份到 <项目名>\ 目录下，导致国旗在包里出现两遍。
       插件只在运行时从 flags\ 目录读图，不消费那份 PRI 资源目录，所以直接删掉它。 -->
  <Target Name="RemoveDuplicateAssetCopy" AfterTargets="Build">
    <RemoveDir Directories="$(OutDir)$(RootNamespace)" ContinueOnError="true" />
  </Target>

  <!-- 构建后：把插件文件拷进宿主 plugins\<id>\ 目录（宿主的运行时文件不拷） -->
  <Target Name="CopyToWinIsland" AfterTargets="Build">
    <ItemGroup>
      <PluginArtifacts Include="$(OutDir)**\*.*" />
      <PluginArtifacts Remove="$(OutDir)WinIsland.Core.dll" />
      <PluginArtifacts Remove="$(OutDir)Microsoft.WinUI.dll" />
      <PluginArtifacts Remove="$(OutDir)Microsoft.Windows.SDK.NET.dll" />
      <PluginArtifacts Remove="$(OutDir)WinRT.Runtime.dll" />
      <PluginArtifacts Remove="$(OutDir)Microsoft.Windows.*.dll" />
      <PluginArtifacts Remove="$(OutDir)Microsoft.Web.WebView2*.dll" />
      <PluginArtifacts Remove="$(OutDir)WebView2Loader.dll" />
      <PluginArtifacts Remove="$(OutDir)Microsoft.Graphics.*.dll" />
      <PluginArtifacts Remove="$(OutDir)Microsoft.InteractiveExperiences.*.dll" />
      <PluginArtifacts Remove="$(OutDir)Microsoft.*.Projection.dll" />
      <PluginArtifacts Remove="$(OutDir)Microsoft.WindowsAppRuntime*" />
      <PluginArtifacts Remove="$(OutDir)**\*.pdb" />
    </ItemGroup>
    <MakeDir Directories="$(PluginTargetDir)" />
    <Copy
      SourceFiles="@(PluginArtifacts)"
      DestinationFiles="@(PluginArtifacts->'$(PluginTargetDir)\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>

</Project>
